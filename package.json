{
  "name": "tripelkins-colony-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-engine.mjs && node scripts/copy-ort.mjs && node scripts/prepare-notices.mjs && vite --host 0.0.0.0",
    "build": "node scripts/build-engine.mjs && node scripts/copy-ort.mjs && node scripts/prepare-notices.mjs && vite build && node scripts/deployment-manifest.mjs && node scripts/prepare-cloudflare-workers.mjs dist cloudflare-workers",
    "verify:cloudflare": "node scripts/verify-cloudflare-workers.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "verify:experience": "node scripts/playthrough.mjs --require-ending",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:scale": "node --expose-gc scripts/benchmark-scale.mjs",
    "benchmark:soak": "node --expose-gc scripts/soak-colony.mjs",
    "benchmark:storage": "node --expose-gc scripts/stress-storage.mjs",
    "verify:community": "node scripts/verify-community.mjs",
    "verify:development": "node scripts/verify-development.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "verify:engine": "node scripts/migration/verify-engine.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "onnxruntime-web": "^1.30.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "vite": "^8.3.1",
    "wrangler": "4.141.0"
  }
}
